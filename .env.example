# Supabase configuration for Nutrivoya.
#
# Copy this file to `.env` and fill in your project values, OR pass the same
# variables via `--dart-define` at build/run time (see README.md).
#
# The app reads these as compile-time constants (see lib/core/config/app_config.dart).
# When left empty, Nutrivoya runs in a limited offline mode so the UI and tests
# remain functional without a backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# USDA FoodData Central API key (optional). Enables the Tier 1 authoritative
# food-composition adapter. Get one at https://fdc.nal.usda.gov/api-key-signup.html
# When empty, food search uses the local curated dataset only.
USDA_FDC_API_KEY=
